# ─── Django ───────────────────────────────────────────────────────────────────
# A long random string. Generate, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# Comma-separated hosts this site answers to (must include the Caddyfile domains).
DJANGO_ALLOWED_HOSTS=samanabuilders.com,www.samanabuilders.com

# ─── Database (PostgreSQL, via the `db` compose service) ─────────────────────
DB_ENGINE=postgres
DB_NAME=samana
DB_USER=samana
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# ─── Email / SMTP (Brevo) ────────────────────────────────────────────────────
EMAIL_ENABLED=True
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_HOST_PORT=587
EMAIL_HOST_USER=youraccount@smtp-brevo.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
# Leave empty to use the SMTP backend configured above. Set to
# django.core.mail.backends.console.EmailBackend to capture mail locally.
EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=Samana Builders <noreply@samanabuilders.com>

# ─── SendPK SMS (optional — set SENDPK_ENABLED=true to enable) ───────────────
SENDPK_ENABLED=False
SENDPK_API_KEY=
SENDPK_SENDER_ID=SMS Alert
SENDPK_BASE_URL=https://sendpk.com/api/sms.php
# Approved fixed-sms templates (account-specific; adjust if you add/change them).
SENDPK_TEMPLATE_CUSTOMER_WELCOME=10904
SENDPK_TEMPLATE_PAYMENT_CONFIRMATION=10901
SENDPK_TEMPLATE_INSTALLMENT_REMINDER=10902
SENDPK_TEMPLATE_OVERDUE_PAYMENT=10903

# ─── WhatsApp Business Cloud (optional — set WHATSAPP_ENABLED=true) ──────────
WHATSAPP_ENABLED=False
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
# Meta-approved template names (one per notification type; blank -> that send fails
# with an explicit message). Names must exist in the Meta app and wa_templates.json.
WHATSAPP_TEMPLATE_PAYMENT_CONFIRMATION=
WHATSAPP_TEMPLATE_BOOKING_NOTIFICATION=
WHATSAPP_TEMPLATE_BOOKING_APPROVAL=
WHATSAPP_TEMPLATE_INSTALLMENT_REMINDER=
WHATSAPP_TEMPLATE_OVERDUE_PAYMENT=
WHATSAPP_TEMPLATE_RECEIPT_NOTIFICATION=

# ─── AI Assistant (OpenRouter, optional) ─────────────────────────────────────
AI_ENABLED=False
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REASONING=True
